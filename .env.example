# ============================================================
# Week 7 · 凭据模板（卫星侧 RAG）
# ============================================================
# 用法：复制成 `.env`（与脚本同级），填上 Key。`.env` 已被 .gitignore 忽略。
#
#   cp .env.example .env
#
# ⚠️ 本周需要**两家厂商**的凭据，别只填一半：
#     · embedding → 阿里云百炼（切块 / 检索 / 评测 全靠它）
#     · chat      → DeepSeek（本卫星侧脚本**不用**；但 week7/java 主线用，故一并列出）
#
#   背景（W5 实测的硬事实）：**DeepSeek 官方 API 没有 `/embeddings` 端点**（打过去 404）。
#   → chat 模型厂商 ≠ 一定有 embedding 服务。两套 Key，两条 base-url。
#
# 📌 脚本实际读 env 的地方在 `../week5/embed_batch.py`（week7 的脚本通过
#    `sys.path.insert(.., "week5")` 复用它）→ **变量名沿用 week5 的既有命名**，
#    同一个 .env 在 week5 / week6 / week7 之间直接通用。
# ============================================================

# ── Embedding（阿里云百炼 · 方案 A，默认）─────────────────
# 注册：bailian.console.aliyun.com → 右上角头像 → API-KEY 管理
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# —— 方案 B（用 B 就注释掉上面三行、放开下面三行）——
# 注册：cloud.siliconflow.cn → API Keys
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# ── Chat（DeepSeek，可选；week7/java 主线需要）──────────────
# 注册：platform.deepseek.com → 充值 → API keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
